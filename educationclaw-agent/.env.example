# Copy this file to ".env" and fill in your values.

# The OpenAI-compatible endpoint, WITHOUT the trailing /chat/completions.
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   Ollama:      http://localhost:11434/v1
#   LM Studio:   http://localhost:1234/v1
#   OpenRouter:  https://openrouter.ai/api/v1
BASE_URL=http://localhost:1234/v1

# The API key (any non-empty string for most local servers).
API_KEY=sk-your-key-here

# The model name the endpoint expects.
MODEL=gpt-4o-mini

# Optional: uncomment to control sampling and reply length.
# TEMPERATURE=0.7
# MAX_TOKENS=1000

# Optional: the dashboard port (default 5000).
# PORT=5000
