# Copy this file to ".env" and fill in your values.

# ---- Model 1 (the default) ------------------------------------------
# The OpenAI-compatible endpoint, WITHOUT the trailing /chat/completions.
# Examples:
#   KI:EZ (NRW): https://chat.kiconnect.nrw/api/v1
#   OpenAI:      https://api.openai.com/v1
#   Ollama:      http://localhost:11434/v1
#   LM Studio:   http://localhost:1234/v1
#   OpenRouter:  https://openrouter.ai/api/v1
BASE_URL=https://chat.kiconnect.nrw/api/v1

# The API key (any non-empty string for most local servers).
API_KEY=your-key-here

# The model name the endpoint expects (quote it if it contains spaces).
MODEL="Mistral Small 4 119B 2603 KI:EZ"

# Optional: uncomment to control sampling and reply length.
# TEMPERATURE=0.7
# MAX_TOKENS=1000

# ---- More models (optional) -----------------------------------------
# Add as many as you like: the same keys with an LLM_<n>_ prefix. The
# dashboard header then shows a model picker — run the same task on two
# models and compare. Any key a numbered model leaves out is taken from
# the plain keys above, so a second model at the same provider needs
# only its MODEL line. LLM_<n>_LABEL is the name shown in the picker
# (optional; the model name is used otherwise — LLM_1_LABEL names model 1).
#
# LLM_2_MODEL="Another model offered by the same endpoint"
# LLM_2_LABEL=Second KI:EZ model
#
# LLM_3_BASE_URL=http://localhost:11434/v1
# LLM_3_API_KEY=ollama
# LLM_3_MODEL=llama3.2
# LLM_3_LABEL=Llama 3.2 (local Ollama)
# LLM_3_TEMPERATURE=0.2

# Optional: the dashboard port (default 5000).
# PORT=5000
